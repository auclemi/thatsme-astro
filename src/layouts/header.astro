---
export interface Props {
    title?: string;
}

const { title = "That's Me !" } = Astro.props;
const pathname = Astro.url.pathname;
---

<div id="header" class="sticky-top">
    <a href="#main-content" class="skip-link visually-hidden text-black">
        Vers contenu principal
    </a>
    <div class="container">
        <nav class="navbar navbar-expand header-background-color sticky-top">
            <div class="d-flex align-items-center">
                <div aria-hidden="true">
                    <a href="/home">
                        <img
                            src="/images/thatsME.png"
                            alt="That's Me Logo"
                            width="100"
                        />
                    </a>
                </div>
                <div>
                    <div class="text-white">
                        <div class="brand title">
                            <span aria-hidden="true">That's Me !</span>
                            <span class="visually-hidden">
                                DatsMi!, votre expert en développement web,
                            </span>
                        </div>
                    </div>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a
                                class="nav-link text-white"
                                href="/home"
                                aria-current={pathname === "/home"
                                    ? "page"
                                    : undefined}
                            >
                                Accueil
                            </a>
                        </li>
                        <li class="nav-item">
                            <a
                                class="nav-link text-white"
                                href="/prestations-web"
                                aria-current={pathname === "/prestations-web"
                                    ? "page"
                                    : undefined}
                            >
                                Prestations Web
                            </a>
                        </li>
                        <li class="nav-item">
                            <a
                                class="nav-link text-white"
                                href="/contact"
                                aria-current={pathname === "/contact"
                                    ? "page"
                                    : undefined}
                            >
                                Contact
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </div>
</div>
